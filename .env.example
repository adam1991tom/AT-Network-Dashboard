# AT Network Dashboard v2
# Copy this file to .env on the deployment host.

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=3080
TZ=Europe/London
DATA_DIR=/data

# Absolute deployment path used by the GUI updater sidecar.
AT_PROJECT_DIR=/opt/AT-Network-Dashboard

# Generated uniquely per installation. Never commit the real value.
AT_MASTER_KEY=CHANGE_ME
SESSION_SECRET=CHANGE_ME

# Optional bootstrap behaviour
FIRST_RUN_SETUP=true

# Set to true only if this app is served over TLS (e.g. behind a reverse
# proxy terminating HTTPS). Controls the Secure flag on session/CSRF cookies.
FORCE_HTTPS=false

# Shared secret between the main app and the docker-agent sidecar (also
# generated uniquely per installation - never commit the real value). The
# same value must be set as the "docker_agent_newtiny_token" secret in
# Settings > Integrations for the main app to be able to call the agent.
DOCKER_AGENT_TOKEN=CHANGE_ME

# Shared secret between the main app and the shell-agent sidecar (also
# generated uniquely per installation - never commit the real value). The
# same value must be set as the "shell_agent_token" secret in
# Settings > Integrations for the main app to be able to call the agent.
# The shell-agent runs commands directly on the host - guard this token like
# a root password, because that is functionally what it is.
SHELL_AGENT_TOKEN=CHANGE_ME
